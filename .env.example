# Reference only: the application does NOT automatically load .env files.
# Export these variables in your shell before starting the service.
QINGLING_ENV=development
QINGLING_STORE_BACKEND=sqlite
QINGLING_SQLITE_PATH=data/qingling.db
QINGLING_AUTH_ENABLED=false

# Required before exposing a network listener. Generate your own random token;
# never commit QINGLING_AUTH_TOKENS_JSON or send it in an issue.
# QINGLING_AUTH_ENABLED=true
# QINGLING_AUTH_TOKENS_JSON=[{"token":"REPLACE_WITH_A_RANDOM_TOKEN","subject":"operator","tenant_id":"demo-tenant","roles":["operator"]}]

# Optional: only configure a gateway you trust to receive investigation data.
# QINGLING_MODEL_GATEWAY_BASE_URL=https://your-gateway.example/v1
# QINGLING_MODEL_GATEWAY_API_KEY=REPLACE_LOCALLY
# QINGLING_EVENT_API_BASE_URL=https://your-event-api.example
# QINGLING_EVENT_API_KEY=REPLACE_LOCALLY

# Optional custom bootstrap definitions and skills; defaults are bundled.
# QINGLING_CONFIG_DIR=config/local
# QINGLING_SKILLS_ROOT=config/local/skills
